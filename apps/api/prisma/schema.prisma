// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     Role

  // Moderation / Activity
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?

  // Restaurants owned by this user (OWNER)
  restaurants Restaurant[] @relation("OwnerRestaurants")

  // Restaurants decided by this user (ADMIN approves/rejects)
  decidedRestaurants Restaurant[] @relation("RestaurantDecisionBy")

  // Moderation actions performed by this user (ADMIN)
  moderationActions UserModerationAction[] @relation("ModeratorActions")

  // Moderation actions targeting this user
  receivedModerationActions UserModerationAction[] @relation("TargetUserActions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  activityLogs ActivityLog[]

  forumThreads ForumThread[]

  forumPosts ForumPost[]
}

model Restaurant {
  id   String @id @default(uuid())
  name String

  contactEmail String?
  contactPhone String?
  category     String?
  rating       Float   @default(0)

  ownerId Int
  owner   User @relation("OwnerRestaurants", fields: [ownerId], references: [id])

  status     RestaurantStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  approvedAt DateTime?
  rejectedAt DateTime?

  decisionById Int?
  decisionBy   User? @relation("RestaurantDecisionBy", fields: [decisionById], references: [id])

  // Delivery zones: many-to-many
  deliveryZones RestaurantDeliveryZone[]
  dishes        Dish[]
  categories    MenuCategory[]
  orders        Order[]
  openingHours  RestaurantOpeningHour[]

  @@index([status])
  @@index([ownerId])
  forumThreads ForumThread[]
}

model Dish {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  price        BigInt
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  categoryId   Int?
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  pictureUrl   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orderItems   OrderItem[]
}

model MenuCategory {
  id           Int        @id @default(autoincrement())
  name         String
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  dishes       Dish[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model RestaurantOpeningHour {
  id           Int        @id @default(autoincrement())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  dayOfWeek    Int
  opensAt      String
  closesAt     String
  isClosed     Boolean    @default(false)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
}

model Order {
  id                 String      @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id])
  customerId         Int
  customer           User        @relation(fields: [customerId], references: [id])
  status             OrderStatus @default(PENDING)
  subtotalAmount     BigInt
  discountAmount     BigInt      @default(0)
  serviceAmount      BigInt      @default(0)
  totalAmount        BigInt
  voucherId          String?
  voucher            Voucher?    @relation(fields: [voucherId], references: [id])
  estimatedArrivalAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items OrderItem[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  dishId     Int?
  dish       Dish?    @relation(fields: [dishId], references: [id])
  name       String
  unitPrice  BigInt
  quantity   Int      @default(1)
  totalPrice BigInt
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([dishId])
}

model UserModerationAction {
  id String @id @default(uuid())

  targetUserId Int
  targetUser   User @relation("TargetUserActions", fields: [targetUserId], references: [id])

  type   ModerationActionType
  reason String?
  until  DateTime?

  moderatorId Int
  moderator   User @relation("ModeratorActions", fields: [moderatorId], references: [id])

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([moderatorId])
}

model ActivityLog {
  id   String       @id @default(uuid())
  type ActivityType

  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  targetType ActivityTargetType?
  targetId   String?
  meta       Json?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, createdAt])
}

model DeliveryZone {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  typicalDeliveryMin Int @default(20)
  typicalDeliveryMax Int @default(40)

  restaurantsLinks RestaurantDeliveryZone[]
}

model RestaurantDeliveryZone {
  restaurantId String
  zoneId       String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  zone         DeliveryZone @relation(fields: [zoneId], references: [id])

  @@id([restaurantId, zoneId])
  @@index([zoneId])
}

model Voucher {
  id         String      @id @default(uuid())
  code       String      @unique
  type       VoucherType
  value      Int // percent z.B. 5 oder fixed cents/euro-logic je nach Konzept
  active     Boolean     @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  usageLimit Int?
  usedCount  Int         @default(0)
  createdAt  DateTime    @default(now())

  orders Order[]
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ForumThread {
  id  Int @id @default(autoincrement())
  title String
  content String
  isClosed Boolean @default(false)
  createdAt DateTime @default(now())

  restaurantId  String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id])

  authorId Int
  author User @relation(fields: [authorId], references: [id])

  post  ForumPost[]

  @@index([restaurantId, createdAt])
  @@index([authorId, createdAt])
}

model ForumPost {
  id Int  @id @default(autoincrement())
  content String
  createdAt DateTime @default(now())

  threadId  Int
  thread  ForumThread @relation(fields: [threadId], references: [id])

  authorId Int
  author User @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum VoucherType {
  PERCENT
  FIXED
}

enum ModerationActionType {
  WARN
  SUSPEND
  UNSUSPEND
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  REJECTED
  CANCELLED
}

enum ActivityType {
  AUTH_LOGIN_SUCCESS
  AUTH_REGISTER

  ADMIN_USER_WARN
  ADMIN_USER_SUSPEND
  ADMIN_USER_UNSUSPEND

  ADMIN_RESTAURANT_APPROVE
  ADMIN_RESTAURANT_REJECT
}

enum ActivityTargetType {
  USER
  RESTAURANT
  Order
  VOUCHER
  ZONE
}
